# ══ SUPERCITADEL env (R8) ══ copy sang .env rồi chỉnh — KHÔNG commit .env
# ⚠️ PRODUCTION: API fail-fast nếu JWT_SECRET/DB_PASSWORD còn giá trị default.

# ── Database ──
DB_USER=citadel
DB_PASSWORD=doi_mat_khau_nay_truoc_khi_deploy
DB_NAME=citadel

# ── Auth ── (bắt buộc đổi — chuỗi ngẫu nhiên ≥32 ký tự, vd: openssl rand -hex 32)
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_dai_32_ky_tu_tro_len

# ── Môi trường ──
# development (mặc định) | production — production BẮT BUỘC set CORS_ORIGIN
NODE_ENV=development
# Danh sách origin được phép gọi API (phẩy nếu nhiều). VD: https://app.example.com
CORS_ORIGIN=

# ── LLM (Tiểu Tâm) ──
# LLM_MODE: stub (không cần key) | live (cần LLM_* bên dưới)
LLM_MODE=stub
# Engine 1 — mặc định (OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_MODEL=cc/claude-sonnet-4-6
LLM_API_KEY=
# Engine 2 — GPT 5.5 (tùy chọn, fallback dùng LLM_API_KEY nếu cùng router)
LLM2_BASE_URL=
LLM2_MODEL=cx/gpt-5.5
LLM2_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Behavior ──
# BETA_MODE: true (default) = energy hiển thị nhưng không cạn; false = enforce hao/hồi thật
BETA_MODE=true
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3002
# BETA OPEN ACCESS: set DEMO_TOKEN = 1 trong 3 token seed để hiện nút "Vào dùng thử ngay".
# Để trống = tắt (mặc định an toàn).
DEMO_TOKEN=
