# ── Citadel V2 env ── copy to .env and adjust
DB_USER=citadel
DB_PASSWORD=citadel_dev
DB_NAME=citadel
JWT_SECRET=change_me_to_a_long_random_string
# LLM_MODE: stub (no key needed) | live (requires key below)
LLM_MODE=stub
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# BETA_MODE (V7A P2): true (default) = energy hiển thị nhưng không bao giờ cạn; false = enforce hao/hồi thật
BETA_MODE=true
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3002
# BETA OPEN ACCESS: set DEMO_TOKEN = 1 trong 3 token seed (vd: CITADEL_OWNER_TOKEN)
# de hien nut "Vao dung thu ngay" o trang login (khong can nguoi dung tu nhap token).
# Backend KHONG doi — van la JWT that qua /auth/login voi token that phia sau.
# De trong = tat tinh nang nay (mac dinh an toan, khong bat buoc phai la beta open access).
DEMO_TOKEN=
