# SOUL-RESTAURANT v1.0.0 — WIRING.patch
# Gắn module vào SuperCitadel: git apply modules/soul-restaurant/WIRING.patch
# (nếu host đã đổi số dòng, apply tay theo 4 điểm chạm — nội dung không đổi)
#
# 4 điểm chạm: ① loader (routes builder + emitTx), ② index.ts (read tools),
# ③ tieu-tam/actions.ts (write actions + emitTx), ④ outbox.ts (subscriber trừ kho).
# Mọi thứ khác module tự lo qua manifest + onActivate/createRestoRoutes.
#
# Host dùng transactional outbox: emitTx = (tx, topic, payload) =>
#   emitEvent(tx, { orgId: payload.org_id, topic, payload })
# → event resto.* ghi TRONG cùng transaction nghiệp vụ (atomic).

--- a/services/api/src/modules/loader.ts
+++ b/services/api/src/modules/loader.ts
@@
 import { buildSoulInventoryRoutes } from '@citadel/module-soul-inventory/server/host-adapter.js';
+import { buildSoulRestaurantRoutes } from '@citadel/module-soul-restaurant/server/host-adapter.js';
+import { emitEvent } from '@citadel/core';
+
+/** Outbox bridge cho soul-restaurant: payload luôn mang org_id (smoke test khẳng định) */
+export const restoEmitTx = (tx: any, topic: string, payload: Record<string, unknown>) =>
+  emitEvent(tx, { orgId: (payload as { org_id: string }).org_id, topic, payload });
@@
   'soul-inventory': (d) => buildSoulInventoryRoutes({ db: d.db, requireAuth: d.requireAuth, gate: d.requireModule(d.db, 'soul-inventory'), audit: d.audit }),
+  'soul-restaurant': (d) => buildSoulRestaurantRoutes({ db: d.db, requireAuth: d.requireAuth, gate: d.requireModule(d.db, 'soul-restaurant'), audit: d.audit, emitTx: restoEmitTx }),
 };

