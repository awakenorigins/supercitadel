{
  "id": "soul-restaurant",
  "name": "Soul-Restaurant — Quản lý Nhà hàng",
  "version": "1.2.0",
  "tier": "paid",
  "priceOm": 1000,
  "icon": "utensils",
  "description": "Nhà hàng/quán ăn trọn gói: sơ đồ bàn theo khu, gọi món có tùy chọn (size/topping/phụ thu), combo, gửi bếp tách phiếu theo trạm (KOT/KDS), lên món, tách bill – gộp bàn – chuyển bàn, giảm giá, thanh toán đa phương thức có tiền thối, đặt bàn chống trùng giờ, báo cáo doanh thu & món bán chạy. Định lượng nguyên liệu nối Soul-Inventory tự trừ kho khi bán (qua event, không import chéo). Tính tiền BigInt chuẩn VN: phí phục vụ + VAT gộp/cộng ngoài. Tiểu Tâm thao tác bằng tiếng Việt, dry-run→confirm cho nghiệp vụ nhạy cảm. v1.1: khuyến mãi (voucher/happy-hour) + khách hàng thân thiết tích/đổi điểm (1 điểm = 1đ), gắn khách theo SĐT. v1.2: bảng điều khiển vận hành (mọi năng lực thành nút thật, sống 100%) + ra món theo lượt (fire-by-course).",
  "permissions": [
    "resto.table.read",
    "resto.table.write",
    "resto.menu.read",
    "resto.menu.write",
    "resto.order.read",
    "resto.order.write",
    "resto.kitchen.read",
    "resto.kitchen.write",
    "resto.bill.read",
    "resto.bill.write",
    "resto.reservation.read",
    "resto.reservation.write",
    "resto.report.read",
    "resto.settings.read",
    "resto.settings.write",
    "resto.promo.read",
    "resto.promo.write",
    "resto.customer.read",
    "resto.customer.write",
    "resto.loyalty.read",
    "resto.loyalty.write"
  ],
  "routes": "/api/v1/soul-restaurant",
  "docs": "docs/GUIDE.md",
  "engine": "^1.0.0",
  "group": "Ẩm thực",
  "rentPlans": {
    "30": 150
  },
