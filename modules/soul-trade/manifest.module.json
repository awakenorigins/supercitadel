{
  "id": "soul-trade",
  "name": "Soul-Trade — AI Trading",
  "version": "1.0.0",
  "description": "Module giao dịch crypto AI cho SuperCitadel: nhiều bot cô lập, 3 chiến lược cắm được (rsi_ema, donchian_breakout, bollinger_meanrev), backtest chống nhìn-trước, nguồn dữ liệu thật qua ccxt (Bybit/Binance/BingX/OKX…), LLM RIÊNG cho từng bot + TỰ CHIA AGENT (signal/risk/sentiment), cắm được LOCAL MODEL (Ollama/LM Studio qua base URL), lưu TRÍ NHỚ từng lượt + phân tích qua các lượt & tổng lượt trade. RLS fail-closed cô lập theo org. Tiểu Tâm điều khiển bằng tiếng Việt.",
  "dependencies": [],
  "conflicts": [],
  "store": {
    "listed": true,
    "category": "module",
    "pricing": {
      "currency": "om",
      "buy": {
        "price": 2200,
        "label": "Mua vĩnh viễn — 2.200 Ôm"
      },
      "rent": {
        "price": 300,
        "period_days": 30,
        "label": "Thuê 30 ngày — 300 Ôm"
      }
    },
    "trial_days": 7,
    "tagline": "Phòng giao dịch có hồn: bot AI tự chia agent, cắm model riêng (kể cả local), nhớ từng lượt và tự phân tích thắng thua — Tiểu Tâm điều khiển bằng tiếng Việt.",
    "highlights": [
      "Nhiều bot cô lập theo org (RLS fail-closed), mỗi bot một chiến lược + cấu hình rủi ro riêng",
      "Nguồn dữ liệu coin THẬT qua ccxt: Bybit, Binance, BingX, OKX… chỉ đổi tên sàn",
      "LLM riêng cho từng bot + TỰ CHIA AGENT (signal/risk/sentiment) — mỗi agent một model",
      "Cắm LOCAL MODEL (Ollama/LM Studio/llama.cpp) qua base URL — chạy offline, không rò dữ liệu",
      "TRÍ NHỚ bền: ghi từng lượt quyết định (chiến lược + AI + phiếu bầu agent), sẵn pgvector để hồi tưởng ngữ nghĩa",
      "Phân tích qua các lượt & TỔNG lượt trade: win rate, profit factor, PnL, avg R, đóng góp từng agent, theo chiến lược",
      "Backtest chống nhìn-trước (vào lệnh nến kế tiếp, SL/TP trong nến), 7 read tools + 6 write actions cho Tiểu Tâm"
    ]
  },
  "permissions": [
    {
      "id": "trade.bot.read",
      "description": "Xem danh sách & trạng thái bot",
      "actions": [
        "read"
      ]
    },
    {
      "id": "trade.bot.write",
      "description": "Tạo/xóa bot",
      "actions": [
        "create",
        "update"
      ]
    },
    {
      "id": "trade.bot.control",
      "description": "Chạy/dừng bot, chạy một lượt đánh giá",
      "actions": [
        "update"
      ]
    },
    {
      "id": "trade.history.read",
      "description": "Xem lịch sử lệnh",
      "actions": [
        "read"
      ]
    },
    {
      "id": "trade.analytics.read",
      "description": "Xem phân tích, trí nhớ, đóng góp agent",
      "actions": [
        "read"
      ]
    },
    {
      "id": "trade.backtest.run",
      "description": "Chạy backtest trên dữ liệu sàn",
      "actions": [
        "create"
      ]
    }
  ],
  "tools": [
